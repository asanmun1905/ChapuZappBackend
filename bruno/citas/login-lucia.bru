meta {
  name: Login Lucía - guarda tokenLucia (200)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "lucia.garcia@chapuzapp.test", "password": "Chapuzapp123" }
}

script:post-response {
  bru.setEnvVar("tokenLucia", res.body.token);
}

assert {
  res.status: eq 200
  res.body.token: isString
}

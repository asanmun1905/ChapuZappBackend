meta {
  name: Login cliente - guarda el token (200)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "cliente@chapuzapp.test", "password": "Chapuzapp123" }
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.token: isString
}

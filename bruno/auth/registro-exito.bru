meta {
  name: Registro - éxito (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Ana Prueba",
    "email": "{{emailNuevo}}",
    "password": "Chapuzapp123",
    "rol": "CLIENTE"
  }
}

script:pre-request {
  bru.setVar("emailNuevo", `ana${Date.now()}@chapuzapp.test`);
}

assert {
  res.status: eq 201
  res.body.passwordHash: isUndefined
}
meta {
  name: Registro - email repetido (409)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Cliente Seed",
    "email": "cliente@chapuzapp.test",
    "password": "Chapuzapp123",
    "rol": "CLIENTE"
  }
}

assert {
  res.status: eq 409
}
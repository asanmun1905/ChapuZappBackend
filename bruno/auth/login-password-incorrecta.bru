meta {
  name: Login - contraseña incorrecta (401)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "cliente@chapuzapp.test",
    "password": "otra"
  }
}

assert {
  res.status: eq 401
  res.body.message: eq Credenciales inválidas
}
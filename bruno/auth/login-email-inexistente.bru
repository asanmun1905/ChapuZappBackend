meta {
  name: Login - email inexistente (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "noexiste@chapuzapp.test",
    "password": "Chapuzapp123"
  }
}

assert {
  res.status: eq 401
  res.body.message: eq Credenciales inválidas
}